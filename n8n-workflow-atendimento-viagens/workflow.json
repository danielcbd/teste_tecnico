{
  "name": "Atendimento e Qualificação de Leads - Agência de Viagens",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-message",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-lead-message",
      "name": "Mensagem Recebida (Lead)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1600,
        0
      ],
      "webhookId": "lead-message"
    },
    {
      "parameters": {
        "jsCode": "// Estado compartilhado do workflow (persiste entre execuções)\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.sessions) staticData.sessions = {};\n\nconst body = $json.body || {};\nconst sessionId = String(body.sessionId || body.from || body.telefone || 'sem-sessao');\nconst messageText = String(body.message || body.text || body.mensagem || '').trim();\n\nif (!staticData.sessions[sessionId]) {\n  staticData.sessions[sessionId] = {\n    active: true,   // false = atendente humano assumiu a conversa\n    waiting: false,  // true = já existe uma execução aguardando a janela de 1min\n    messages: [],\n  };\n}\n\nconst session = staticData.sessions[sessionId];\n\n// Se um humano já assumiu essa conversa, o agente não deve responder\nif (session.active === false) {\n  return [{ json: { sessionId, shouldProcess: false, reason: 'agente_desativado_por_atendente_humano' } }];\n}\n\nif (messageText) {\n  session.messages.push({ text: messageText, timestamp: new Date().toISOString() });\n}\n\n// A primeira mensagem da janela abre a espera de 1min.\n// Mensagens seguintes dentro da mesma janela só se acumulam como contexto.\nconst startWait = !session.waiting;\nif (startWait) {\n  session.waiting = true;\n}\n\nreturn [{\n  json: {\n    sessionId,\n    shouldProcess: true,\n    startWait,\n  }\n}];"
      },
      "id": "code-registrar-mensagem",
      "name": "Registrar Mensagem e Verificar Estado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1360,
        0
      ]
    },
    {
      "parameters": {
