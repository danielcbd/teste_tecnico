      "parameters": {
        "jsCode": "// AJUSTAR CONFORME O PAYLOAD REAL DA UAZAPI (não foi possível confirmar os nomes exatos\n// de campo neste ambiente - o acesso à documentação da UAZAPI está bloqueado aqui).\n// Modelo assumido, comum em APIs baseadas em Baileys (mesma família da Evolution API):\n// {\n//   \"event\": \"messages.upsert\",\n//   \"instance\": \"minha-instancia\",\n//   \"data\": {\n//     \"key\": { \"remoteJid\": \"5511999999999@s.whatsapp.net\", \"fromMe\": false, \"id\": \"ABC123\" },\n//     \"pushName\": \"João Silva\",\n//     \"message\": { \"conversation\": \"Oi, tudo bem?\" }\n//   }\n// }\nconst body = $json.body || {};\nconst data = body.data || body;\nconst key = data.key || {};\n\nconst remoteJid = key.remoteJid || data.chatid || data.phone || '';\nconst phone = String(remoteJid).replace('@s.whatsapp.net', '').replace('@g.us', '');\n\nconst text =\n  data?.message?.conversation ||\n  data?.message?.extendedTextMessage?.text ||\n  data?.text ||\n  data?.body ||\n  '';\n\nconst fromMe = Boolean(key.fromMe ?? data.fromMe ?? false);\nconst externalId = key.id || data.id || null;\nconst pushName = data.pushName || data.senderName || null;\n\nreturn [{\n  json: {\n    phone,\n    text: String(text).trim(),\n    fromMe,\n    externalId,\n    pushName,\n  }\n}];"
      },
