    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"resposta\": {\n      \"type\": \"string\",\n      \"description\": \"Mensagem a ser enviada de volta ao lead\"\n    },\n    \"classificacao\": {\n      \"type\": \"string\",\n      \"enum\": [\"frio\", \"morno\", \"quente\"],\n      \"description\": \"Classificação de temperatura do lead\"\n    },\n    \"resumo_qualificacao\": {\n      \"type\": \"string\",\n      \"description\": \"Resumo curto do que foi entendido sobre o lead (destino, período, orçamento, urgência)\"\n    }\n  },\n  \"required\": [\"resposta\", \"classificacao\"]\n}"
      },
