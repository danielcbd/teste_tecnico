    {
      "parameters": {
        "jsCode": "const ctx = $('Preparar Contexto e Calcular Gap').item.json;\nconst saida = $json.output;\n\nlet reutilizarAtendimento = false;\nif (ctx.temAtendimentoAnterior) {\n  reutilizarAtendimento = ctx.possivelNovoAssunto ? saida.mesmo_assunto === true : true;\n}\n\nreturn [{\n  json: {\n    ...ctx,\n    ...saida,\n    reutilizarAtendimento,\n  }\n}];"
      },
