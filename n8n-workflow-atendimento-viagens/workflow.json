    {
      "parameters": {
        "jsCode": "// Disparado quando o atendente humano responde manualmente pelo canal oficial\n// (ex.: evento 'fromMe' do WhatsApp / mensagem enviada pelo operador no CRM).\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.sessions) staticData.sessions = {};\n\nconst body = $json.body || {};\nconst sessionId = String(body.sessionId || body.to || body.telefone || 'sem-sessao');\n\nif (!staticData.sessions[sessionId]) {\n  staticData.sessions[sessionId] = { active: true, waiting: false, messages: [] };\n}\n\n// Desativa o agente para esta conversa e descarta mensagens do lead ainda não respondidas\nstaticData.sessions[sessionId].active = false;\nstaticData.sessions[sessionId].messages = [];\nstaticData.sessions[sessionId].waiting = false;\n\nreturn [{ json: { sessionId, active: false } }];"
      },
