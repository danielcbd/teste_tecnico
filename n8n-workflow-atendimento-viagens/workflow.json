        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"resposta\": { \"type\": \"string\", \"description\": \"Mensagem a ser enviada de volta ao lead\" },\n    \"classificacao\": { \"type\": \"string\", \"enum\": [\"frio\", \"morno\", \"quente\"] },\n    \"topico\": { \"type\": \"string\", \"description\": \"Rótulo curto do assunto deste atendimento\" },\n    \"resumo_atendimento\": { \"type\": \"string\", \"description\": \"Resumo atualizado e cumulativo do atendimento\" },\n    \"mesmo_assunto\": { \"type\": \"boolean\", \"description\": \"true se continua o atendimento anterior, false se é assunto novo\" }\n  },\n  \"required\": [\"resposta\", \"classificacao\", \"topico\", \"resumo_atendimento\", \"mesmo_assunto\"]\n}"
      },
      "id": "output-parser",
      "name": "Formato de Saída",
