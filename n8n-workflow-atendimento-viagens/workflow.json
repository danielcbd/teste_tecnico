    {
      "parameters": {
        "resume": "timeInterval",
        "unit": "seconds",
        "amount": 60
      },
      "id": "wait-60s",
      "name": "Aguardar 1min (janela de contexto)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        -640,
        -160
      ],
      "webhookId": "wait-lead-message"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst sessionId = $json.sessionId;\nconst session = staticData.sessions[sessionId];\n\n// Se o atendente humano assumiu durante a espera, aborta o envio automático\nif (!session || session.active === false) {\n  return [{ json: { sessionId, shouldProcess: false, reason: 'assumido_por_humano_durante_espera' } }];\n}\n\nconst context = session.messages.map(m => m.text).filter(Boolean).join('\\n');\nconst messageCount = session.messages.length;\n\n// Limpa a fila e libera a sessão para a próxima janela de 1min\nsession.messages = [];\nsession.waiting = false;\n\nreturn [{\n  json: {\n    sessionId,\n    shouldProcess: true,\n    context,\n    messageCount,\n  }\n}];"
      },
      "id": "code-coletar-mensagens",
      "name": "Coletar Mensagens da Janela",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
